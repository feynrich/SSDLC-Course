# Настройки PostgreSQL
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_HOST=postgres

# Настройки мониторинга
CHECK_INTERVAL=30
LOG_FILE=/app/logs/pinger.log

# Настройки Vault (заполняются автоматически vault-init)
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID_FILE=/run/secrets/role_id.txt
VAULT_SECRET_ID_FILE=/run/secrets/secret_id.txt
VAULT_SECRET_PATH=creds